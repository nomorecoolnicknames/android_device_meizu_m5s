// 32-bit build of the AOSP Bluetooth HIDL service. The stock libbt-vendor.so
// is 32-bit only, so the 64-bit AOSP service cannot load it. The passthrough
// android.hardware.bluetooth@1.0-impl is built for both ABIs.
cc_binary {
    name: "android.hardware.bluetooth@1.0-service.m5s",
    defaults: ["hidl_defaults"],
    relative_install_path: "hw",
    proprietary: true,
    compile_multilib: "32",
    srcs: ["service.cpp"],
    shared_libs: [
        "liblog",
        "libcutils",
        "libdl",
        "libbase",
        "libutils",
        "libhardware",
        "libhidlbase",
        "libhidltransport",
        "android.hardware.bluetooth@1.0",
    ],
}
