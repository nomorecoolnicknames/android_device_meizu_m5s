<!--
  Device HAL manifest (VINTF). The framework only starts the Wi-Fi vendor HAL
  if IWifi is declared; without it the MTK combo driver is never powered up
  and wlan0 never appears. Other HALs resolve through the passthrough
  fallback. Declare only services that actually run: a declared but unserved
  HAL hangs its clients.
-->
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.wifi</name>
        <transport>hwbinder</transport>
        <version>1.2</version>
        <interface>
            <name>IWifi</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.wifi.supplicant</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>ISupplicant</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
