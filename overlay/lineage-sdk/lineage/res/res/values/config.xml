<?xml version="1.0" encoding="utf-8"?>
<!--
     config_deviceHardwareKeys is a bit field:
       1 Home, 2 Back, 4 Menu, 8 Assist, 16 AppSwitch, 32 Camera, 64 Volume.
     The M5s has one front key (the mBack home button on the Goodix fingerprint
     module) plus the volume rocker: 1 (Home) + 64 (Volume) = 65.

     config_longPressOnHomeBehavior=2: long-press Home opens Recents.
-->
<resources>
    <integer name="config_deviceHardwareKeys">65</integer>
    <integer name="config_longPressOnHomeBehavior">2</integer>
</resources>
