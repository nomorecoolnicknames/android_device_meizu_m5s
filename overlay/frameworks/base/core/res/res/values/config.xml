<?xml version="1.0" encoding="utf-8"?>
<!--
  M5s framework resources. Double-tap wake depends on the ft5x46 kernel driver.
  Legacy connectivity arrays and unavailable GMS package settings are not inherited.
-->

<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Backlight: LUX/backlight pairs carried from the 15.1 tree. -->
    <integer name="config_screenBrightnessSettingMinimum">1</integer>
    <integer name="config_screenBrightnessDim">20</integer>
    <bool name="config_automatic_brightness_available">true</bool>

    <integer-array name="config_autoBrightnessLevels">
        <item>10</item>
        <item>200</item>
        <item>320</item>
        <item>450</item>
        <item>580</item>
        <item>700</item>
        <item>850</item>
        <item>950</item>
        <item>1500</item>
        <item>3000</item>
        <item>5000</item>
        <item>7000</item>
        <item>9000</item>
        <item>11000</item>
        <item>13000</item>
        <item>15000</item>
        <item>17000</item>
    </integer-array>

    <integer-array name="config_autoBrightnessLcdBacklightValues">
        <item>1</item>
        <item>12</item>
        <item>91</item>
        <item>103</item>
        <item>107</item>
        <item>113</item>
        <item>120</item>
        <item>129</item>
        <item>134</item>
        <item>152</item>
        <item>224</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
        <item>255</item>
    </integer-array>

    <!-- Dual SIM, both slots hot-swappable (FACT: stock ro.telephony.sim.count=2,
         ro.mtk_sim_hot_swap=1). -->
    <bool name="config_hotswapCapable">true</bool>

    <!-- The microSD slot is in the hybrid SIM tray, reachable without opening
         the phone. -->
    <bool name="config_batterySdCardAccessibility">true</bool>

    <bool name="config_unplugTurnsOnScreen">true</bool>

    <string-array translatable="false" name="config_tether_usb_regexs">
        <item>rndis\\d</item>
    </string-array>

    <string-array translatable="false" name="config_tether_wifi_regexs">
        <item>ap0</item>
    </string-array>

    <string-array translatable="false" name="config_tether_bluetooth_regexs">
        <item>bt-pan</item>
    </string-array>

    <bool name="config_cellBroadcastAppLinks">true</bool>
    <bool name="config_safe_media_volume_enabled">true</bool>
    <bool name="config_dreamsEnabledByDefault">true</bool>
    <bool name="config_restart_radio_on_pdp_fail_regular_deactivation">false</bool>
    <bool name="config_speed_up_audio_on_mt_calls">true</bool>

    <!-- PA22x ALS/PS is live on this unit (FACT: probe/sensors.txt, and the
         driver was ported for the 3.18 line — docs/PORT_PA22X.md). -->
    <bool name="config_suspendWhenScreenOffDueToProximity">true</bool>

    <!-- Doze / power -->
    <string name="config_dozeComponent">com.android.systemui/com.android.systemui.doze.DozeService</string>
    <integer name="config_screenBrightnessDoze">3</integer>
    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
    <bool name="config_enableAutoPowerModes">true</bool>
    <bool name="config_nightDisplayAvailable">true</bool>

    <!-- ft5x46 touch controller: the 15.1 tree claims gesture wake works. -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <bool name="config_intrusiveNotificationLed">true</bool>

    <bool name="config_enableWifiDisplay">false</bool>
</resources>
