#
# system.prop for the Meizu M5s
#
# MTK hardware properties live in vendor.prop. ro.zygote, ro.product.* and the
# dalvik heap sizes come from the build system and must not be set here.
#

# Display density (720x1280 panel)
ro.sf.lcd_density=320

# Software navigation bar: the only front key is the fingerprint home button.
qemu.hw.mainkeys=0

# OpenGL ES 3.1 (Mali-T720 MP3)
ro.opengles.version=196609

# Tethering
net.tethering.noprovisioning=true

# DRM (Widevine L3, 32-bit only)
drm.service.enabled=true

# HWUI
# Buffer age bootloops the M2 Note, which has the same SoC, GPU and HWC 1 stack.
debug.hwui.use_buffer_age=false
