# MTK modem init chain. The vendor tree ships ccci_mdinit, ccci_fsd,
# gsm0710muxd, muxreport, terservice and mtkrild but no init script for
# them; without it the modem never starts and rild restarts forever.

# The MTK libril resets the modem once after boot while ril.muxreport is
# unset, which takes the whole modem chain down. Seed the property before
# rild starts so that path is skipped.
on post-fs-data
    setprop ril.muxreport 0
    mkdir /data/nvram/md 0770 root system
    mkdir /data/ccci_cfg 0770 system radio
    mkdir /data/mdlog 0775 shell system
    chown radio radio /sys/kernel/ccci/boot
    chown radio radio /sys/class/BOOT/BOOT/boot/md
    chown radio radio /dev/ccci_fs
    chown radio radio /dev/ccci_ioctl0
    chown radio radio /dev/ccci_ioctl1
    chown radio radio /dev/ccci_monitor
    chown radio radio /dev/ttyC0
    chown media audio /dev/ccci_aud
    restorecon /data/ccci_cfg

service nvram_daemon /vendor/bin/nvram_daemon
    class main
    user root
    group system

service ccci_fsd /vendor/bin/ccci_fsd 0
    class main
    user radio
    group radio system
    oneshot

# ccci_mdinit must run as root, and it gives up if NVRAM is not ready yet,
# so it is started on the NVRAM ready property.
service ccci_mdinit /vendor/bin/ccci_mdinit 0
    class main
    user root
    group radio system
    disabled
    oneshot

on property:service.nvram_init=Ready
    start ccci_mdinit

# The ramdisk init.modem.rc starts gsm0710muxd on init_done, before the modem
# handshake has finished, and the mux gives up after 10 s. `override`
# replaces that service with a wrapper that waits (up to 30 s) for the second
# modem handshake before starting the real muxd.
# No '$' in the command: init expands $x as a property name.
service gsm0710muxd /system/bin/sh -c "timeout 30 sh -c 'while ! dmesg | grep -q md_hs2_msg_notify; do sleep 1; done'; exec /vendor/bin/gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic"
    override
    class main
    user root
    group radio cache inet misc
    disabled
    oneshot

service muxreport-daemon /vendor/bin/muxreport
    class main
    user radio
    group radio cache inet misc
    disabled
    oneshot

service terservice /vendor/bin/terservice
    class main
    user radio
    group radio system inet
    disabled
    oneshot

# The chain does not self-start. init_done is ccci_mdinit's own readiness and
# can come before the modem is up, so the mux is also started on "ready".
on property:mtk.md1.status=init_done
    chown radio radio /dev/ttyC0
    start terservice
    start gsm0710muxd

on property:mtk.md1.status=ready
    chown radio radio /dev/ttyC0
    start terservice
    start gsm0710muxd

on property:init.svc.gsm0710muxd=running
    start ril-daemon-mtk

# muxreport issues the modem reset, so it is armed only by the RIL
# (ril.muxreport=1), never just because the mux is running.
on property:ril.muxreport=1
    start muxreport-daemon

# MTK HIDL rild built from vendor/mediatek/ril. It keeps the name
# ril-daemon-mtk because ccci_mdinit starts and stops it by that name;
# `override` replaces the ramdisk definition.
service ril-daemon-mtk /vendor/bin/hw/rild
    override
    class main
    socket rild stream 660 root radio
    socket rild2 stream 660 root radio
    socket rild3 stream 660 root radio
    socket rild4 stream 660 root radio
    socket rild-ims stream 660 root radio
    socket rild-debug stream 660 radio system
    socket rild-oem stream 660 radio system
    socket rild-mtk-ut stream 660 radio net_bt
    socket rild-mtk-ut-2 stream 660 radio net_bt
    socket rild-mtk-modem stream 660 radio system
    socket rild-atci stream 660 root radio
    socket rild-mal stream 660 radio system
    socket rild-mal-at stream 660 radio system
    socket rild-vsim stream 660 root radio
    socket sap_uim_socket1 stream 660 bluetooth bluetooth
    user root
    group radio cache inet misc audio sdcard_r sdcard_rw log system
    disabled
    oneshot

# Disabled stub for the AOSP ril-daemon from an older rild.legacy.rc; init
# ignores the later duplicate definition.
service ril-daemon /vendor/bin/hw/rild
    override
    class main
    user root
    group radio
    disabled
    oneshot
