# Bluetooth HAL service and local address.
#
# The service replaces the 64-bit AOSP one, because the stock libbt-vendor.so
# is 32-bit only (see bluetooth_hal/Android.bp). It keeps the AOSP service
# name, with `override` because both rc files may be present.
# libbluetooth_mtk reads the NVRAM BD address in this process, so the HAL
# also needs access to BT_Addr.
#
# The AOSP HAL aborts unless an address property is set; m5s-bdaddr.sh
# publishes the NVRAM address as persist.service.bdroid.bdaddr. The HAL reads
# it on Bluetooth enable, so post-fs-data is early enough.
#
# /dev/stpbt: the ramdisk ueventd rule names group net_bt_stack, which does
# not exist on Pie, so the node ends up root:root 0600.

on post-fs-data
    chown bluetooth bluetooth /dev/stpbt
    chmod 0660 /dev/stpbt
    chown root bluetooth /data/nvram/APCFG/APRDEB/BT_Addr
    chmod 0660 /data/nvram/APCFG/APRDEB/BT_Addr
    exec_background - root bluetooth -- /vendor/bin/sh /vendor/bin/m5s-bdaddr.sh

# /dev/stpbt only exists once wmt_loader has loaded the connectivity drivers,
# long after post-fs-data, so the chown is repeated when wmtLoader stops and
# at boot_completed. Both can race ueventd, so m5s-stpbt-perm.sh also waits
# for the node and logs the result to /dev/kmsg.

on property:init.svc.wmtLoader=stopped
    chown bluetooth bluetooth /dev/stpbt
    chmod 0660 /dev/stpbt
    exec_background - root root -- /vendor/bin/sh /vendor/bin/m5s-stpbt-perm.sh

on property:sys.boot_completed=1
    chown bluetooth bluetooth /dev/stpbt
    chmod 0660 /dev/stpbt

service vendor.bluetooth-1-0 /vendor/bin/hw/android.hardware.bluetooth@1.0-service.m5s
    override
    class hal
    capabilities BLOCK_SUSPEND NET_ADMIN SYS_NICE
    user bluetooth
    group bluetooth radio net_bt net_bt_admin inet system
    writepid /dev/stune/foreground/tasks
