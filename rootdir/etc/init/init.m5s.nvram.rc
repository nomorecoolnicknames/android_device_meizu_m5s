# M5s uses a real /data/nvram directory mirrored from /nvdata.
# Create it before daemon startup; the M5c symlink layout is different.

on post-fs-data
    # nvram_daemon runs `cp fstab* -f /data/nvram/` from / and libnvram then
    # parses /data/nvram/fstab.<ro.hardware> for the /nvram raw partition
    # (FACT, strings: vendor/meizu/m5s/proprietary/vendor/bin/nvram_daemon has
    # "cp fstab* -f /data/nvram/", proprietary/vendor/lib64/libnvram.so has
    # "/data/nvram/fstab.%s").  On Android 13 / is the system image and
    # fstab.mt6735 exists only in the boot ramdisk (INFERENCE: device.mk puts
    # it into the ramdisk and /vendor/etc exactly as m5c's does, and the m5c
    # build of 2026-09-17 has /ramdisk/fstab.mt6735 and no fstab in
    # out/.../root/), so the daemon's copy finds nothing.  On m95 the same wall
    # made nvram_daemon exit 1 ("failed to read /data/nvram/fstab.mt6797"),
    # service.nvram_init never became Ready, the audio HAL, ccci_mdinit, GPS
    # and MAL waited on it, StartAudioService took 100 s and the Watchdog
    # killed system_server in a loop.
    mkdir /data/nvram 0771 root system
    copy /vendor/etc/fstab.mt6735 /data/nvram/fstab.mt6735
    chmod 0644 /data/nvram/fstab.mt6735

# Bluetooth address from NVRAM (m95 lesson, device/meizu/m95 15d2dc9).
# The AOSP BT HAL of this tree aborts with "No Bluetooth Address!" unless an
# address property is set (hardware/interfaces/bluetooth/1.0/default/
# vendor_interface.cc:217); m5s-bdaddr.sh publishes the NVRAM one as
# persist.service.bdroid.bdaddr.  The HAL (user bluetooth) also reads BT_Addr
# itself through libnvram (FACT: libbluetooth_mtk.so NEEDED libnvram.so),
# hence the regroup.  Both wait for NVRAM's own Ready flag: nvram_daemon
# restores BT_Addr only after post-fs-data, and on m95 the publisher, started
# earlier, found no file on a fresh /data and the HAL aborted ("Open: No
# Bluetooth Address!", tombstone_18).
# No seclabel and no domain yet: in permissive mode init only logs the missing
# transition and runs the script in init's domain
# (system/core/init/service.cpp:97-100).  An enforcing build needs a domain,
# as m95 has (seclabel u:r:m95_bdaddr:s0).
service m5s_bdaddr /vendor/bin/sh /vendor/bin/m5s-bdaddr.sh
    class core
    user root
    group root bluetooth
    oneshot
    disabled

on property:service.nvram_init=Ready
    chown root bluetooth /data/nvram/APCFG/APRDEB/BT_Addr
    chmod 0660 /data/nvram/APCFG/APRDEB/BT_Addr
    start m5s_bdaddr
