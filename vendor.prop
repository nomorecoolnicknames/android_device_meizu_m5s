# M5s vendor properties. Early-init inputs belong in PRODUCT_PROPERTY_OVERRIDES,
# not in /vendor/build.prop, which is unreadable before mounting vendor.

# --- Platform identity (drives hw_get_module lookups) ----------------------
# FACT: probe/build.prop and probe/getprop.txt on the live stock install.
# ro.board.platform and ro.hardware are DIFFERENT strings on this device and
# both matter: modules are named *.mt6753, but init looks for init.mt6735.rc
# and fstab.mt6735.
ro.board.platform=mt6753
ro.mediatek.platform=MT6753
ro.mediatek.chip_ver=S01
ro.mediatek.version.sdk=4
ro.mediatek.version.release=alps-mp-m0.mp1-V2.94_gr6753.66c.mz.m0_P147

# --- HAL module selection --------------------------------------------------
# FACT: probe/hw_libs.txt carries gps.mt6753.so; the MTK PowerHAL is
# power.mt6753.so.  Both are looked up through these properties rather than
# ro.board.platform in Android 13.
ro.hardware.gps=mt6753
ro.hardware.power=mt6753

# --- Panel -----------------------------------------------------------------
# FACT: probe/getprop.txt ro.sf.hwrotation=0 (the m2note donor tree had 180).
ro.sf.hwrotation=0

# --- MTK combo chip (Wi-Fi / BT / GPS / FM share one CONSYS) ---------------
# FACT: the LOS 15.1 tree pins the chip id for this handset rather than
# auto-detecting (m5c leaves it -1).
persist.mtk.wcn.combo.chipid=0x0337
persist.mtk.wcn.fwlog.status=0
service.wcn.driver.ready=no
persist.mtk.combo.coredump=no

# --- Wi-Fi ----------------------------------------------------------------
mediatek.wlan.chip=CONSYS_MT6735
mediatek.wlan.module.postfix=_consys_mt6735
ro.mediatek.wlan.wsc=1
ro.mediatek.wlan.p2p=1
mediatek.wlan.ctia=0
ro.mtk_wlan_support=1
wifi.tethering.interface=wlan0
wifi.interface=wlan0
wifi.direct.interface=p2p0
wifi.supplicant_scan_interval=180

# --- Bluetooth ------------------------------------------------------------
ro.mtk_bt_support=1

# --- Telephony (dual SIM, LTE) --------------------------------------------
# rild.libpath is an absolute /vendor path now that there is a real vendor
# partition (the 15.1 tree used the bare soname).
rild.libpath=/vendor/lib64/mtk-ril.so
rild.libargs=-d /dev/ttyC0
ro.telephony.sim.count=2
ro.telephony.default_network=20,20
persist.radio.multisim.config=dsds
persist.radio.default.sim=0
persist.radio.mobile.data=0,0
persist.radio.fd.counter=15
persist.radio.fd.off.counter=5
persist.radio.fd.r8.counter=15
persist.radio.fd.off.r8.counter=5
ril.current.share_modem=2
ril.external.md=0
ril.telephony.mode=0
ro.mtk_enable_md1=1
ro.mtk_lte_support=1
ro.mtk_gemini_support=1
ro.mtk_gemini_enhancement=1
persist.gemini.sim_num=2
ro.gemini.smart_sim_switch=false
ro.mtk_sim_hot_swap=1
ro.mtk_world_phone=1
ro.mtk_eap_sim_aka=1
ro.mtk_rild_read_imsi=1
ro.mtk_flight_mode_power_off_md=1
ril.flightmode.poweroffMD=1
persist.md.perm.checked=1
keyguard.no_require_sim=true
bgw.current3gband=0

# --- GPS ------------------------------------------------------------------
ro.mtk_gps_support=1
ro.mtk_agps_app=1

# --- Audio ----------------------------------------------------------------
ro.camera.sound.forced=0
ro.audio.silent=0
persist.af.audio_patch_fm=1
# Same MTK legacy audio HAL family as the m5c: audio.primary.mt6753.so never
# assigns audio_stream_in::get_capture_position, so the AOSP wrapper's NULL
# check passes on uninitialised heap and the indirect call jumps into the
# malloc arena.  On the m5c this crashed the audio service on EVERY microphone
# capture (ten tombstones, 2026-09-03).  The guard is opt-in.
# HYPOTHESIS: the guard still exists in A13's audio default impl and the m5s
# blob has the same gap.  Verify before relying on it.
ro.audio.legacy_hal_no_capture_position=1

# --- Camera ---------------------------------------------------------------
media.stagefright.legacyencoder=true
media.stagefright.less-secure=true
camera.disable_zsl_mode=1

# --- FM -------------------------------------------------------------------
fmradio.driver.enable=0

# --- Display / MiraVision -------------------------------------------------
persist.sys.display.clearMotion=0
ro.mtk_clearmotion_support=0
wfd.dummy.enable=1
persist.debug.wfd.enable=1

# --- USB ------------------------------------------------------------------
ro.sys.usb.mtp.whql.enable=0
ro.sys.usb.storage.type=mtp
ro.vold.umsdirtyratio=20
ro.sys.usb.bicr=no
ro.sys.usb.charging.only=yes

# --- FRP ------------------------------------------------------------------
# FACT: the stock property points at the full by-name node, and on m5s frp is
# mmcblk0p19 (probe/partitions.txt + scatter order).
ro.frp.pst=/dev/block/platform/mtk-msdc.0/11230000.msdc0/by-name/frp

# --- Misc -----------------------------------------------------------------
ro.oem_unlock_supported=1
ro.mtk_cta_set=1
sys.ipo.pwrdncap=2

# The legacy USB gadget kernel lacks the configfs accessory, audio-source, FunctionFS and MIDI functions.
# This property bypasses only the kernel RuntimeInfo check, leaving HAL/manifest checks enabled.
# Remove it when the required configfs functions are available.
ro.vendor.vintf.legacy_kernel=true
